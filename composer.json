{
    "name": "light-php/light-php",
    "description": "A tiny Core PHP framework with routing, controllers, views and helpers.",
    "type": "project",
    "keywords": ["php", "framework", "light-php", "core-php"],
    "homepage": "https://github.com/Dayal574/Light-PHP",
    "support": {
        "issues": "https://github.com/Dayal574/Light-PHP/issues",
        "source": "https://github.com/Dayal574/Light-PHP"
    },
    "authors": [
        {
            "name": "Dayal Chandra Roy",
            "homepage": "https://github.com/Dayal574"
        }
    ],
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Core/helpers.php",
            "app/Helpers/helpers.php",
            "app/Core/DB.php",
            "app/Core/Request.php"
        ]
    }
}
