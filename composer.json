{
    "name": "dayal/lightweight-php-framework",
    "description": "A tiny Core PHP framework with routing, controllers, views and helpers.",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Core/helpers.php",
            "app/Helpers/helpers.php",
            "app/Core/DB.php",
            "app/Core/Request.php"
        ]
    }
}
